# PostgreSQL — Supabase connection string
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Gemini (free alternative)
GEMINI_API_KEY=AIza...

# Optional: Groq (fast inference, OpenAI-compatible tool calling)
GROQ_API_KEY=gsk_...

# Optional: any OpenAI-Chat-Completions-compatible endpoint — api.openai.com
# itself, or a self-hosted server (vLLM, etc).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: LiteLLM Proxy — a standalone AI gateway the backend can route
# every call through instead of talking to a provider directly (real admin
# UI, per-key budgets/rate-limits, provider fallback). See
# backend/litellm-proxy/README.md to stand it up; leave AI_PROVIDER as one
# of the four providers above to skip this entirely, as today.
# LITELLM_PROXY_MODEL must be one of the `model_name` values in
# backend/litellm-proxy/config.yaml, not a raw provider model string.
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_PROXY_API_KEY=
LITELLM_PROXY_MODEL=llama-groq

# Which AI provider to use: anthropic | gemini | groq | openai | litellm_proxy
AI_PROVIDER=anthropic

# Max LLM calls in flight to the provider at once, across every request the
# backend is serving — caps a burst of students hitting AI-backed endpoints
# simultaneously from all landing on the provider together and tripping its
# own rate limit. See Settings.ai_max_concurrent_calls in app/core/config.py.
AI_MAX_CONCURRENT_CALLS=8

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

PORT=3001

# Logging level (DEBUG | INFO | WARNING | ERROR). DEBUG also enables
# SQLAlchemy SQL echo — see app/database.py.
LOG_LEVEL=INFO

# Langfuse tracing (optional) — leave both keys blank to disable tracing
# entirely (no overhead, no log noise). Get keys from your Langfuse project
# Settings -> API Keys. LANGFUSE_HOST: https://cloud.langfuse.com (EU),
# https://us.cloud.langfuse.com (US), or your self-hosted URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Sandbox runner: docker (default, local dev) | kubernetes (in-cluster, see k8s/README.md)
SANDBOX_RUNNER=docker
