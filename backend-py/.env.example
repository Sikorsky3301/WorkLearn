# PostgreSQL — Supabase connection string
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Gemini (free alternative)
GEMINI_API_KEY=AIza...

# Which AI provider to use: anthropic | gemini
AI_PROVIDER=anthropic

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

PORT=3001

# Sandbox runner: docker (default, local dev) | kubernetes (in-cluster, see k8s/README.md)
SANDBOX_RUNNER=docker
